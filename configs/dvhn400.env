# Copy this file to a private location, replace every /path/to value, then source it.
ROOT=/path/to/ultralytics
PKG=/path/to/Phase3_Reproducibility_Repository/scripts/phase3
P2=/path/to/FieldGuide_Phase2_FRP_20260916
RUNS=/path/to/runs/phase3
W=/path/to/Phase3_Reproducibility_Repository/weights/frp_stageA_v1_best.pt
CKPT=/path/to/Phase3_Reproducibility_Repository/weights/ddm_v3_train_20261001_last.pt
RGBT=/path/to/RGBT-3M/RGBT
M3FD=/path/to/M3FD_hardneg_scene_v1
DV=/path/to/DVHN400

export PYTHONPATH="$ROOT:$PKG:$P2:$P2/../FieldGuide_Phase2_FieldUse_20260916:${PYTHONPATH:-}"
export PHY_F3D_SCALE=50
export PHY_DDM_W1=0.5 PHY_DDM_W2=0.3 PHY_DDM_W3=0.2
export PHY_FG_MODE=fixed PHY_FG_ALPHA=0.5
export PHY_FRP=1 PHY_STAGE=3 PHY_FG=1 PHY_FIELD_IMPL=heatfield
export PHY_FRP_TAU=0.045 PHY_FRP_CC_IMPL=batched PHY_FRP_TOPK=0
export PHY_DDM=1 PHY_DDM_CUE_MODE=depth PHY_DDM_VETO_C=0.25 PHY_DDM_FIELD_VETO_T=0
export PHY_FRP_MEMCKPT=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Native frozen DAv2-L path used by the depth-cache builder.
export PHY_DEPTH_REPO=/path/to/Depth-Anything-V2
export PHY_DEPTH_WEIGHTS=/path/to/depth_anything_v2_vitl.safetensors
